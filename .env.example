# ==========================================
# ERO ERP VE - Configuración de Entorno
# ==========================================

# Servidor / API
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Base de Datos MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_admin
DB_PASSWORD=SecurePassword_2026!
DB_NAME=ero_erp_db
DB_CONNECTION_LIMIT=20

# Redis & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT RS256 / Tokens de Autenticación
# Claves en formato PEM (una línea con saltos de línea codificados o path)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad & Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Configuración Fiscal Venezuela (Valores por defecto)
DEFAULT_IVA_RATE=16.00
DEFAULT_IGTF_RATE=3.00
DEFAULT_CURRENCY=USD
SECONDARY_CURRENCY=VES
BCV_API_URL=https://pydolarvenezuela-api.vercel.app/api/v1/dollar
SENIAT_CONTRIBUTOR_TYPE=SPECIAL # SPECIAL o ORDINARY

# Almacenamiento & Logs
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
LOG_LEVEL=debug

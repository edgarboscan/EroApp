{
  "name": "ero-erp-ve",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise ERP for Venezuelan Market (SENIAT, Multi-Branch, Dynamic Dashboards, Advanced Pricing & Hierarchy Inventory)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @ero/shared build && pnpm --parallel --filter @ero/* dev",
    "build": "pnpm --filter @ero/shared build && pnpm --filter @ero/api build && pnpm --filter @ero/web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1",
    "db:generate": "pnpm --filter @ero/api db:generate",
    "db:migrate": "pnpm --filter @ero/api db:migrate",
    "db:seed": "pnpm --filter @ero/api db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "core-js",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}